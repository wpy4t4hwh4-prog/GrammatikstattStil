[Unit]
Description=Research-Hub Dashboard (serve.py, Live-API mit serverseitigem Mistral-Key)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/research-hub/dashboard
EnvironmentFile=/etc/research-hub.env
ExecStart=/usr/bin/python3 serve.py --port 8765 --host 127.0.0.1
Restart=always
RestartSec=3
# Sicherheit: kein Schreibzugriff noetig ausser data/ (qv.db, outbox) innerhalb des App-Dirs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/research-hub/dashboard/data
ProtectHome=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
